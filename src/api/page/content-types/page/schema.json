{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "metaDescription": {
      "type": "text"
    },
    "pageSections": {
      "type": "dynamiczone",
      "components": [
        "page.section",
        "page.banner"
      ]
    }
  }
}
