{
  "kind": "collectionType",
  "collectionName": "semesters",
  "info": {
    "singularName": "semester",
    "pluralName": "semesters",
    "displayName": "Semester"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "registrationDeadline": {
      "type": "datetime",
      "required": true
    },
    "isActive": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "subscriptionFulls": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::subscription-full.subscription-full",
      "mappedBy": "semester"
    }
  }
}
