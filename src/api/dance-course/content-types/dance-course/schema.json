{
  "kind": "collectionType",
  "collectionName": "dance_courses",
  "info": {
    "singularName": "dance-course",
    "pluralName": "dance-courses",
    "displayName": "Dance Course"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "level": {
      "type": "string",
      "required": true
    },
    "danceStyle": {
      "type": "relation",
